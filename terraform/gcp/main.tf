# GCP Provider Configuration
# Connects Terraform to our nexcloud-platform GCP project
# Region and project are passed as variables for flexibility

terraform {
  required_version = ">= 1.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}